{
  "name": "the-noumenon-library",
  "version": "0.1.0",
  "private": true,
  "//type": "Every file here is already ESM (.ts/.tsx/.mjs; not one .js or .cjs in the repo). Declaring it stops Node re-parsing scripts/review-models.ts to guess, which it warns about on every run of the daily job.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "takedown": "node --env-file=.env.local scripts/takedown.mjs",
    "invite": "node --env-file=.env.local scripts/invite.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "restore:verify": "node --env-file-if-exists=.env.local scripts/restore-verify.mjs",
    "models:review": "node --env-file-if-exists=.env.local scripts/review-models.ts",
    "wander": "node scripts/wander-sample.mjs",
    "deploy:prod": "git push origin main:prod"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "next": "16.2.7",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
